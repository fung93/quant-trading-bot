# Public client config - anon key ONLY. RLS restricts this key to read-only
# access on the `candles` table. The service role key must NEVER appear in
# dashboard/ or in Vercel env vars.
#
# Local dev: copy to dashboard/.env.local and fill in (Supabase dashboard ->
# Project Settings -> API keys). Vercel: set both in Project Settings ->
# Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
