# Supabase credentials (dedicated quant-bot project).
# Server-side only: the service role key bypasses RLS and must never reach
# a client, the dashboard, or Vercel env vars. Copy to .env for local runs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Binance API base URL. Defaults to data-api.binance.vision,
# Binance's official public market-data host, because api.binance.com is
# ISP-blocked in Malaysia. Uncomment to override.
# BINANCE_BASE_URL=https://api.binance.com
